# Copia este fichero a .env y rellena las claves.
# .env está en .gitignore y no debe subirse nunca.

# PROVEEDORES, por orden de preferencia. Se usa el primero que responda; los
# que fallan se apartan solos y vuelven cuando se recuperan. Un proveedor sin
# clave simplemente no existe, así que para quitar uno basta con borrarla.

# Preferente: endpoint compatible con OpenAI (Bedrock, OpenRouter, Groq, otro).
# Si no lo tienes, borra estas tres y se usará DeepSeek directamente.
AWS_API_KEY=
AWS_API_URL=https://bedrock-mantle.eu-west-2.api.aws/v1/chat/completions
AWS_MODEL=deepseek.v3.2

# Obligatoria: modelo de lenguaje para las preguntas libres
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: transcripción de notas de voz (Groq Whisper).
# Sin ella el bot sigue funcionando, pero solo con texto.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelo concreto. Por defecto deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# Cuánto se apoya en el modelo:
#   conversacional  todo lo redacta el modelo (por defecto, mejor calidad)
#   equilibrado     el modelo solo para lo conversacional y lo ambiguo
#   ahorro          sin modelo salvo preguntas libres (el más barato)
MODO_IA=conversacional

TZ=Europe/Madrid
LOG_LEVEL=info
